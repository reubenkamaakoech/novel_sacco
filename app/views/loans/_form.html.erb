<script>
document.addEventListener("turbo:load", () => {
  const memberSelect = document.getElementById("member_select");

  if (memberSelect && !memberSelect.disabled) {
    // Build a JS object: member_id => has active loan
    const activeLoans = <%= raw Member.all.map { |m| [m.id, m.loans.where(status: true).exists?] }.to_h.to_json %>;

    // Disable options with active loans
    Array.from(memberSelect.options).forEach(option => {
      const memberId = parseInt(option.value);
      if (memberId && activeLoans[memberId]) {
        option.disabled = true;           // disable the option
        option.text += " (Active loan)";  // append text to show why
      }
    });
  }
});
</script>


<!-- This script calculates the net disbursement for a refinanced loan -->
<script>
document.addEventListener("turbo:load", function () {
  const amountField = document.getElementById("loan_amount");
  const balanceCell = document.getElementById("old-loan-balance");
  const netCell = document.getElementById("net-disbursement");

  if (!amountField || !balanceCell || !netCell) return;

  const outstanding = parseFloat(balanceCell.dataset.balance);

  function updateNetDisbursement() {
    const loanAmount = parseFloat(amountField.value) || 0;
    const net = loanAmount - outstanding;

    if (loanAmount <= outstanding) {
       netCell.innerHTML =
     "<span class='text-danger'>New loan amount must be greater than the outstanding balance.</span>";
    } else {
      netCell.innerText = new Intl.NumberFormat("en-KE", {
       style: "currency",
       currency: "KES"
    }).format(net);
    }

    netCell.innerText = new Intl.NumberFormat("en-KE", {
      style: "currency",
      currency: "KES"
    }).format(net);
  }

  amountField.addEventListener("input", updateNetDisbursement);

  updateNetDisbursement();
});
</script>
