<% content_for :title, "Sacco Account" %>

<div class="px-5">
  <div class="row mb-4">
    <!-- Total Savings Card -->
    <div class="col-md-2">
      <div class="card border-success shadow-sm">
        <div class="card-body">
          <h5 class="card-title text-success">Total Savings</h5>
          <p class="card-text h4">
            <%= number_to_currency(@total_savings || 0, unit: "Ksh ") %>
          </p>
        </div>
      </div>
    </div>

    <!-- Available Savings Card -->
  <div class="col-md-2">
    <div class="card border-info shadow-sm">
      <div class="card-body">
        <h5 class="card-title text-info">Available Savings</h5>
        <p class="card-text h4">
          <%= number_to_currency(@available_savings, unit: "Ksh ") %>
        </p>
      </div>
    </div>
  </div>

  <!-- Monthly Contribution + Repayment Card -->
  <div class="col-md-2">
    <div class="card border-info shadow-sm">
      <div class="card-body">
        <h5 class="card-title text-warning">Monthly Contribution + Repayment</h5>
        <p class="card-text h4">
          <%= number_to_currency(Member.total_monthly_collections, unit: "Ksh ") %>
        </p>
      </div>
    </div>
  </div>


    <!-- Available for Loans Card -->
    <div class="col-md-2">
      <div class="card border-primary shadow-sm">
        <div class="card-body">
          <h5 class="card-title text-primary">Available for Loans (<%= 100 - AppConfig.locked_percentage %>%) </h5>
          <p class="card-text h4">
            <%= number_to_currency((@total_savings - Member.locked_ratio * (@total_savings || 0)), unit: "Ksh ") %>
          </p>
        </div>
      </div>
    </div>

    <!-- Loans Balance  -->
    <div class="col-md-2">
      <div class="card border-primary shadow-sm">
        <div class="card-body">
          <h5 class="card-title text-primary">Loan Balance</h5>
          <p class="card-text h4">
            <td><%= number_to_currency(@loan_balance || 0, unit:"Ksh ") %></td>
          </p>
        </div>
      </div>
    </div>

    <!-- Locked Savings Card -->
    <div class="col-md-2">
      <div class="card border-danger shadow-sm">
        <div class="card-body">
          <h5 class="card-title text-danger">Locked Savings (<%= AppConfig.locked_percentage %>%) </h5>
          <p class="card-text h4">
            <%= number_to_currency(Member.locked_ratio * (@total_savings || 0), unit: "Ksh ") %>
          </p>
        </div>
      </div>
    </div>
  </div>
  

<table class="table table-striped">
  <thead class="table-primary">
    <tr>
      <th>Id</th>
      <th>Member</th>
      <th>Total Savings</th>
      <th>Available Savings</th>
      <th>Contribution + Repayment</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
      <% total_savings = 0 %>
    <% @savings_summary.each do |record| %>
      
      <tr>
        <td><%= record.id %></td>
        <td><%= record.name %></td>
        <td><%= number_to_currency(record.total_savings, unit: "Ksh ") %></td>
        <td><%= number_to_currency(record.available_savings, unit: "Ksh ") %></td>      
        <td class="<%= 'text-danger fw-bold' if record.loans.exists?(status: true) %>">
          <%= number_to_currency(record.monthly_total, unit: "Ksh ") %></td>        
        </td>
        <td>
          <%= link_to "View Satement", member_statement_path(member_id: record.id), class: "btn btn-info btn-sm" %>
        </td>
      </tr>
       <% total_savings += record.available_savings %>
    <% end %>
  
  </tbody>
</table>
  <div> 
    <%= link_to "Create random saving", new_saving_path, class:"btn btn-success btn-sm" %> 
  </div><br/>

  <div class="mb-3 p-3 border rounded bg-light">
  <h5>Create Monthly Ordinary Savings</h5>
  <%= form_with url: create_monthly_savings_path, method: :post, local: true, class: "row g-2 align-items-center" do |form| %>
    <div class="col-auto">
    
      <%= form.select :month,
          Date::MONTHNAMES.compact.each_with_index.map { |name, i| [name, i+1] },
          {selected: Date.today.month},
          class: "form-select" %>  
      </div>
    
      <div class="col-auto">
    
      <%= form.number_field :year,
          value: Date.today.year,
          class: "form-control",
          min: 2000,
          max: 2100 %>
      </div>

    <div class="col-auto">
      <%= form.submit "Create Monthly Savings",
          class: "btn btn-success btn-sm",
          data: { confirm: "Create ordinary savings for the selected month and year?" } %>
    </div>
  <% end %>
</div>
</div>





